{
  "permissions": {
    "allow": [
      "PowerShell(Get-Command cloudflared -ErrorAction SilentlyContinue)",
      "PowerShell(npm install -g localtunnel 2>&1)",
      "PowerShell(Invoke-WebRequest -Uri \"http://localhost:3000\" -UseBasicParsing -TimeoutSec 5)",
      "PowerShell(Invoke-WebRequest -Uri \"http://localhost:3000\" -UseBasicParsing | Select-Object -ExpandProperty Headers | Where-Object { $_.Key -eq \"Content-Security-Policy\" })",
      "PowerShell(Get-Process -Name \"node\" -ErrorAction SilentlyContinue)",
      "PowerShell(Stop-Process -Force)",
      "PowerShell(Get-Process -Name \"cloudflared\" -ErrorAction SilentlyContinue)",
      "Skill(run)",
      "Skill(run:*)",
      "PowerShell(Get-Content \"$env:TEMP\\\\gm_build.log\" -ErrorAction SilentlyContinue | Select-Object -Last 15)",
      "PowerShell(Get-Content \"$env:TEMP\\\\gm_build.log\" -ErrorAction SilentlyContinue | Select-Object -Last 20)",
      "PowerShell(Get-Content \"$env:TEMP\\\\gm_build.log\" -ErrorAction SilentlyContinue | Select-Object -Last 25)",
      "PowerShell(gh auth status 2>&1)",
      "PowerShell(winget install --id GitHub.cli --silent --accept-package-agreements --accept-source-agreements 2>&1)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git commit -m ' *)"
    ]
  }
}
